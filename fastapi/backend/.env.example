# Copy this file to .env and fill in your values before running the server.

# MongoDB connection string
# Explicitly telling MongoDB to authenticate via the admin database
MONGODB_URL=mongodb://admin:claimit123@16.170.110.232:27017/?authSource=admin

# Database name
DATABASE_NAME=claimit_db

# JWT secret — use a long random string (e.g. openssl rand -hex 32)
SECRET_KEY=change_me_to_a_long_random_secret

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Static OTP for development testing (skip SMS provider)
STATIC_OTP=123456

# Twilio SMS credentials
# Get these from https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# The Twilio phone number to send SMS from (E.164 format, e.g. +1234567890)
TWILIO_PHONE_NUMBER=+1234567890
# Default country code for 10-digit numbers (India = +91)
TWILIO_DEFAULT_COUNTRY_CODE=+91

# SMTP Email credentials (used when user logs in with an email address)
# For Gmail: enable 2-Step Verification, then generate an App Password at:
# https://myaccount.google.com/apppasswords  (use that instead of your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=Claimit

AWS_ACCESS_KEY_ID=AKIA53CJHAB2KKEHKTJ6
AWS_SECRET_ACCESS_KEY=HmCHciBeoCKCDXFIbpArVs860SQZ9S69EpLs3X8e
AWS_REGION=eu-north-1
AWS_STORAGE_BUCKET_NAME=claimit-image-bucket

# Firebase Cloud Messaging (push notifications) — service account
# Generate at Firebase console → Project settings → Service accounts → Generate new private key,
# save the JSON file under fastapi/backend/secret/ (gitignored), then point to it here.
FIREBASE_PROJECT_ID=claimit-fcm
FIREBASE_SERVICE_ACCOUNT_PATH=secret/your-service-account-file.json