# Copy this file to .env and fill in your values before running the server.

# MongoDB connection string
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net
MONGODB_URL=mongodb+srv://aroganamtech:ax1zJdu8KjCvFqnU@careerblitz.zkjrg.mongodb.net/

# Database name
DATABASE_NAME=claimit_db

# JWT secret — use a long random string (e.g. openssl rand -hex 32)
SECRET_KEY=change_me_to_a_long_random_secret

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Static OTP for development testing (skip SMS provider)
STATIC_OTP=123456
