# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT  →  copy this file to .env and fill in your values.
# VERCEL PRODUCTION  →  add these same keys in:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#   (never commit the real .env file to Git)
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Get it from: Atlas Dashboard → Connect → Drivers → Python
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URL=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/

# The name of the database inside your Atlas cluster
DATABASE_NAME=claimit_db

# JWT signing secret — generate with:  openssl rand -hex 32
# Use a DIFFERENT value in production than in development.
SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dev-only: static OTP so you don't need an SMS provider locally.
# Set to a real SMS provider integration key in production.
STATIC_OTP=123456
