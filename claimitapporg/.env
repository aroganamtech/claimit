# ── Social Login Keys ─────────────────────────────────────────────────────────
# Replace these dummy values with real credentials before release.
#
# Google:
#   Get from https://console.cloud.google.com → APIs & Services → Credentials
#   Create an OAuth 2.0 Client ID for Android + iOS + Web.
#
# Facebook:
#   Get from https://developers.facebook.com → Your App → Settings → Basic
#
# Usage:
#   flutter run \
#     --dart-define=GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID \
#     --dart-define=GOOGLE_CLIENT_ID_IOS=$GOOGLE_CLIENT_ID_IOS \
#     --dart-define=FACEBOOK_APP_ID=$FACEBOOK_APP_ID \
#     --dart-define=FACEBOOK_CLIENT_TOKEN=$FACEBOOK_CLIENT_TOKEN

