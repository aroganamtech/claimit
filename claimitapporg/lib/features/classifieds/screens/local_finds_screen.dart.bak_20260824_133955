// ── Shared business-contact actions (used by listing/detail screens too) ──────
Future<void> lfCall(String phone) async {
  final p = phone.replaceAll(RegExp(r'[^0-9+]'), '');
  if (p.isEmpty) return;
  await launchUrl(Uri.parse('tel:$p'));
}

Future<void> lfWhatsApp(String phone) async {
  var p = phone.replaceAll(RegExp(r'[^0-9]'), '');
  if (p.isEmpty) return;
  if (p.length == 10) p = '91$p';
  await launchUrl(Uri.parse('https://wa.me/$p'), mode: LaunchMode.externalApplication);
}

Future<void> lfNavigate(String address, {double? lat, double? lng}) async {
  final Uri uri = (lat != null && lng != null)
      ? Uri.parse('https://www.google.com/maps/search/?api=1&query=$lat,$lng')
      : Uri.parse(
          'https://www.google.com/maps/search/?api=1&query=${Uri.encodeComponent(address)}');
  await launchUrl(uri, mode: LaunchMode.externalApplication);
}

// ── Shared location helpers (best-effort; degrade gracefully) ─────────────────
Future<Position?> lfCurrentPosition() async {
  try {
    if (!await Geolocator.isLocationServiceEnabled()) return null;
    var perm = await Geolocator.checkPermission();
    if (perm == LocationPermission.denied) perm = await Geolocator.requestPermission();
    if (perm == LocationPermission.denied || perm == LocationPermission.deniedForever) {
      return null;
    }
    return await Geolocator.getCurrentPosition(
        desiredAccuracy: LocationAccuracy.low);
  } catch (_) {
    return null;
  }
}

String? lfDistanceLabel(Position? me, double? lat, double? lng) {
  if (me == null || lat == null || lng == null) return null;
  final m = Geolocator.distanceBetween(me.latitude, me.longitude, lat, lng);
  if (m < 950) return '${m.round()} m';
  final km = m / 1000;
  return '${km.toStringAsFixed(km < 10 ? 1 : 0)} Km';
}

class LocalFindsScreen extends StatefulWidget {
  const LocalFindsScreen({super.key});

  @override
  State<LocalFindsScreen> createState() => _LocalFindsScreenState();
}

class _LocalFindsScreenState extends State<LocalFindsScreen> {
  List<ClassifiedPost> _nearby = [];
  bool _loading = true;
  Position? _me;
  final Set<String> _liked = {};

  @override
  void initState() {
    super.initState();
    _load();
  }

  Future<void> _load() async {
    final results = await Future.wait([
      ClassifiedService.instance.fetchClassifieds(listingType: 'local_find'),
      lfCurrentPosition(),
    ]);
    if (!mounted) return;
    final list = results[0] as List<ClassifiedPost>;
    final me = results[1] as Position?;

    // Order: Premium first, then Standard, then Free; and within each tier the
    // nearest business first (based on the user's current location).
    int planRank(String p) =>
        p == 'premium' ? 0 : (p == 'standard' ? 1 : 2);
    double distOf(ClassifiedPost b) {
      if (me == null || b.latitude == null || b.longitude == null) {
        return double.infinity;
      }
      return Geolocator.distanceBetween(
          me.latitude, me.longitude, b.latitude!, b.longitude!);
    }

    list.sort((a, b) {
      final r = planRank(a.plan).compareTo(planRank(b.plan));
      if (r != 0) return r;
      return distOf(a).compareTo(distOf(b));
    });

    setState(() {
      _nearby = list;
      _me = me;
      _loading = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.white,
      appBar: AppBar(
        backgroundColor: Colors.white,
        elevation: 0.5,
        leading: IconButton(
          icon: const Icon(Icons.arrow_back_ios_new_rounded, color: kLfBlue, size: 20),
          onPressed: () => context.pop(),
        ),
        // Logo on the left, right after the back arrow, then the page title.
        // Same asset + size + text fallback the home and shop-list headers use
        // (home_main_logo.png already contains the icon + "claimit" wordmark).
        titleSpacing: 0,
        title: Row(
          children: [
            Image.asset(
              'assets/images/home_main_logo.png',
              height: 30,
              fit: BoxFit.contain,
              errorBuilder: (_, __, ___) => const Text(
                'claimit',
                style: TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.w700,
                  color: Color(0xFF1565C0),
                ),
              ),
            ),
            const SizedBox(width: 10),
            // Flexible + ellipsis so the title can never overflow the row
            // beside the logo at a large system font size.
            const Flexible(
              child: Text(
                'Local Finder',
                maxLines: 1,
                overflow: TextOverflow.ellipsis,
                style: TextStyle(
                    color: kLfBlue, fontWeight: FontWeight.w700, fontSize: 18),
              ),
            ),
          ],
        ),
        // Owners reach their own business listings here. Scoped to
        // listingType 'local_find', so Classifieds posts never appear.
        actions: [
          IconButton(
            tooltip: 'My Listings',
            icon: const Icon(Icons.receipt_long_rounded, color: kLfBlue, size: 22),
            onPressed: () => context.push('/local-finds/mine'),
          ),
        ],
      ),
      body: RefreshIndicator(
        onRefresh: _load,
        child: ListView(
          padding: const EdgeInsets.fromLTRB(16, 14, 16, 28),
          children: [
            LfDiscoverBanner(onRegister: () => context.push('/local-finds/add')),
            const SizedBox(height: 24),
            _sectionHeader('Categories',
                () => context.push('/local-finds/categories')),
            const SizedBox(height: 14),
            LfCategoriesGrid(
              columns: 4,
              onTap: (z) => context.push('/classified/zone', extra: z),
            ),
            const SizedBox(height: 26),
            _sectionHeader('Nearby Businesses',
                () => context.push('/local-finds/categories')),
            const SizedBox(height: 12),
            if (_loading)
              const Padding(
                  padding: EdgeInsets.all(28),
                  child: Center(child: CircularProgressIndicator(color: kLfBlue)))
            else if (_nearby.isEmpty)
              _emptyNearby()
            else
              ..._nearby.take(10).map((b) => _businessCard(context, b)),
            const SizedBox(height: 18),
            _registerButton(context),
          ],
        ),
      ),
    );
  }

  Widget _sectionHeader(String title, VoidCallback onSeeAll) => Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(title,
              style: const TextStyle(fontSize: 19, fontWeight: FontWeight.w800, color: kLfBlue)),
          GestureDetector(
            onTap: onSeeAll,
            child: const Text('See All',
                style: TextStyle(fontSize: 13.5, fontWeight: FontWeight.w600, color: kLfBlue)),
          ),
        ],
      );

  // ── Nearby business card (image + name + location + chips + heart) ──────────
  Widget _businessCard(BuildContext context, ClassifiedPost b) {
    final name = b.businessName.isNotEmpty ? b.businessName : b.title;
    final id = b.id.isNotEmpty ? b.id : name;
    final liked = _liked.contains(id);
    final dist = lfDistanceLabel(_me, b.latitude, b.longitude);
    final cat = b.subcategory.isNotEmpty ? b.subcategory : b.category;
    return GestureDetector(
      onTap: () => context.push('/classified/detail', extra: b),
      child: Container(
        margin: const EdgeInsets.only(bottom: 12),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(14),
          border: Border.all(color: const Color(0xFFEEF1F5)),
          boxShadow: [BoxShadow(color: Colors.black.withOpacity(0.04), blurRadius: 8)],
        ),
        child: IntrinsicHeight(
          child: Row(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            ClipRRect(
              borderRadius: const BorderRadius.only(
                  topLeft: Radius.circular(14), bottomLeft: Radius.circular(14)),
              child: _thumb(b),
            ),
            Expanded(
              child: Padding(
                padding: const EdgeInsets.fromLTRB(12, 12, 10, 12),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    Row(
                      children: [
                        Expanded(
                          child: Text(name,
                              maxLines: 1,
                              overflow: TextOverflow.ellipsis,
                              style: const TextStyle(
                                  fontSize: 15.5, fontWeight: FontWeight.w700, color: kLfInk)),
                        ),
                        GestureDetector(
                          onTap: () => setState(() =>
                              liked ? _liked.remove(id) : _liked.add(id)),
                          child: Icon(
                              liked ? Icons.favorite_rounded : Icons.favorite_border_rounded,
                              size: 20, color: liked ? Colors.redAccent : kLfBlue),
                        ),
                      ],
                    ),
                    const SizedBox(height: 4),
                    Text(
                        b.address.isNotEmpty
                            ? b.address
                            : (b.area.isNotEmpty ? b.area : cat),
                        maxLines: 1,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(fontSize: 12.5, color: kLfMuted)),
                    const SizedBox(height: 8),
                    Wrap(
                      spacing: 8,
                      runSpacing: 4,
                      children: [
                        if (dist != null) _chip(dist, accent: true),
                        _chip(cat),
                      ],
                    ),
                  ],
                ),
              ),
            ),
          ],
          ),
        ),
      ),
    );
  }

  Widget _chip(String label, {bool accent = false}) => Container(
        padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
        decoration: BoxDecoration(
            color: accent ? const Color(0xFFE3EEFC) : const Color(0xFFEFF3F8),
            borderRadius: BorderRadius.circular(20)),
        child: Text(label,
            style: TextStyle(
                fontSize: 11.5,
                color: accent ? kLfBlue : kLfInk,
                fontWeight: FontWeight.w500)),
      );

  Widget _thumb(ClassifiedPost b) {
    if (b.photos.isNotEmpty) {
      try {
        return Image.memory(base64Decode(b.photos.first),
            width: 108, height: 108, fit: BoxFit.cover,
            errorBuilder: (_, __, ___) => _thumbFallback());
      } catch (_) {}
    }
    return _thumbFallback();
  }

  Widget _thumbFallback() => Container(
      width: 108, height: 108, color: const Color(0xFFEFF3F8),
      child: const Icon(Icons.storefront_rounded, color: kLfBlue, size: 34));

  Widget _emptyNearby() => Container(
        padding: const EdgeInsets.all(24),
        alignment: Alignment.center,
        child: const Text('No businesses nearby yet. Be the first to register!',
            style: TextStyle(color: kLfMuted)),
      );

  Widget _registerButton(BuildContext context) => SizedBox(
        width: double.infinity,
        child: ElevatedButton.icon(
          onPressed: () => context.push('/local-finds/add'),
          icon: const Icon(Icons.add_business_rounded),
          label: const Text('Register Your Business'),
          style: ElevatedButton.styleFrom(
            backgroundColor: kLfGold,
            foregroundColor: Colors.black,
            elevation: 0,
            padding: const EdgeInsets.symmetric(vertical: 14),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
          ),
        ),
      );
}

