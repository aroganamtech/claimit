/// The 12-category icon grid used on both the home and the Categories screen.
class LfCategoriesGrid extends StatelessWidget {
  final int columns;
  final void Function(LocalFindZone zone) onTap;
  final List<LocalFindZone>? zones;
  const LfCategoriesGrid(
      {super.key, this.columns = 4, required this.onTap, this.zones});

  @override
  Widget build(BuildContext context) {
    final w = MediaQuery.of(context).size.width;
    final iconSize = (w / (columns + 1)).clamp(52.0, 80.0);
    final list = zones ?? localFindZones;
    return GridView.count(
      crossAxisCount: columns,
      shrinkWrap: true,
      physics: const NeverScrollableScrollPhysics(),
      mainAxisSpacing: 18,
      crossAxisSpacing: 8,
      childAspectRatio: 0.80,
      children: list
          .map((z) => GestureDetector(
                behavior: HitTestBehavior.opaque,
                onTap: () => onTap(z),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    z.iconAsset != null
                        ? Image.asset(z.iconAsset!,
                            width: iconSize, height: iconSize, fit: BoxFit.contain,
                            errorBuilder: (_, __, ___) => _fallback(z, iconSize))
                        : _fallback(z, iconSize),
                    const SizedBox(height: 6),
                    // Longer names ("Professional Services", "Fitness &
                    // Wellness") shrink to fit rather than truncating to
                    // "Professional S…". scaleDown never grows the text and
                    // never overflows the tile.
                    FittedBox(
                      fit: BoxFit.scaleDown,
                      child: Text(z.title,
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                          style: const TextStyle(
                              fontSize: 12, fontWeight: FontWeight.w600, color: kLfInk)),
                    ),
                  ],
                ),
              ))
          .toList(),
    );
  }

  Widget _fallback(LocalFindZone z, double size) => Container(
        width: size, height: size,
        decoration: const BoxDecoration(color: kLfBanner, shape: BoxShape.circle),
        child: Icon(z.icon, size: size * 0.5, color: kLfBlue),
      );
}
