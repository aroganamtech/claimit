  Widget _stepBody() {
    switch (_step) {
      case 0:
        return _stepAbout();
      case 1:
        return _stepContact();
      case 2:
        return _stepServices();
      case 3:
        return _stepPlan();
      default:
        return _stepReview();
    }
  }

  // ── Step 1 ─────────────────────────────────────────────────────────────────
