    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        // Photo comes first — it's the first thing customers see on the card
        // and profile, so it's collected up front rather than buried later.
        _label('Your Photo'),
        Row(
          children: [
            GestureDetector(
              onTap: _pickProfilePhoto,
              child: Container(
                width: 96,
                height: 96,
                decoration: BoxDecoration(
                  color: const Color(0xFFEFF5FF),
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: kSelAccent),
                ),
                child: _photoB64 == null
                    ? const Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          Icon(Icons.add_a_photo_rounded, color: kSelAccent),
                          SizedBox(height: 4),
                          Text('Add photo',
                              style: TextStyle(fontSize: 10.5, color: kSelAccent)),
                        ],
                      )
                    : ClipRRect(
                        borderRadius: BorderRadius.circular(11),
                        child: Image.memory(
                          base64Decode(_photoB64!),
                          fit: BoxFit.cover,
                          width: 96,
                          height: 96,
                          errorBuilder: (_, __, ___) => const Icon(
                              Icons.broken_image_rounded, color: kSelMuted),
                        ),
                      ),
              ),
            ),
            const SizedBox(width: 12),
            Expanded(
              child: Text(
                _photoB64 == null
                    ? 'A clear photo of you. This is what customers see on '
                        'your card and profile.'
                    : 'Looking good. Tap the photo to change it.',
                style: const TextStyle(
                    fontSize: 12, color: kSelMuted, height: 1.45),
              ),
            ),
          ],
        ),
        _label('Your Name'),
        _field(_nameCtrl, 'e.g. Ananya Menon'),
        _label('Category'),
        Container(
          decoration: _boxDeco(),
          padding: const EdgeInsets.symmetric(horizontal: 12),
          child: DropdownButtonHideUnderline(
            child: DropdownButton<String>(
              isExpanded: true,
              value: _categoryId,
              hint: const Text('Select your category'),
              items: kSelectCategories
                  .map((c) => DropdownMenuItem(
                        value: c.id,
                        child: Text(
                          c.label,
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
