      'Your photo and who you are',
      'How customers reach and find you',
      'What you offer, and your work',
      'Premium listings rank at the top',
      'Check everything before you pay',
    ];

    return Scaffold(
      backgroundColor: kSelBg,
      appBar: AppBar(
