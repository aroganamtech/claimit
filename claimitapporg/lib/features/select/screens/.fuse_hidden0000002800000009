            ),
          ),
        ),
        _label('Your Title'),
        _field(_roleCtrl, 'e.g. Interior Designer'),
        _label('Years of Experience'),
        _field(_expCtrl, 'e.g. 8', keyboard: TextInputType.number, digitsOnly: true),
        _label('Consultation Fee (₹)'),
        _field(_feeCtrl, 'e.g. 499', keyboard: TextInputType.number, digitsOnly: true),
        const SizedBox(height: 4),
        const Text(
          'This is what you charge per consultation. Customers pay you '
          'directly — Claimit does not collect it.',
          style: TextStyle(fontSize: 11.5, color: kSelMuted, height: 1.4),
        ),
        _label('About You'),
        _field(_aboutCtrl, 'A short introduction customers will read', maxLines: 4),
      ],
    );
  }

