// ─────────────────────────────────────────────────────────────────────────────
// Claimit Select — "List yourself" (professional self-registration).
//
//   Step 1  About you        — name, category, role, experience, about, fee
//   Step 2  Contact & area   — phone, email, pincode-driven address
//   Step 3  Services & photos— services, profile photo, portfolio
//   Step 4  Listing plan     — Premium / Standard / Custom, then payment
//
// PAYMENT: the listing fee is charged with Razorpay through the app's existing
// payment-link flow (PaymentService → POST /payments/create-link → hosted
// Razorpay checkout → poll until PAID). The Custom plan may be any amount
// including ₹0, which is free and skips payment entirely. Premium/Standard
// prices come live from GET /select/plans, which the web admin Pricing page
// controls — the server also recomputes them, so a tampered client can't
// under-pay.
// ─────────────────────────────────────────────────────────────────────────────

class SelectRegisterFlow extends StatefulWidget {
  const SelectRegisterFlow({super.key, this.existing});

  /// When supplied the flow runs in EDIT mode: every field is prefilled from
  /// the user's current listing, and saving updates it in place (the backend
  /// upserts on user_id, so no duplicate is created).
  final SelectProfessional? existing;

  @override
  State<SelectRegisterFlow> createState() => _SelectRegisterFlowState();
}

class _SelectRegisterFlowState extends State<SelectRegisterFlow> {
  int _step = 0; // 0..3

  // ── Step 1 ─────────────────────────────────────────────────────────────────
  final _nameCtrl = TextEditingController();
  final _roleCtrl = TextEditingController();
  final _aboutCtrl = TextEditingController();
  final _expCtrl = TextEditingController();
  final _feeCtrl = TextEditingController();
  String? _categoryId;

  // ── Step 2 ─────────────────────────────────────────────────────────────────
  final _phoneCtrl = TextEditingController();
  final _emailCtrl = TextEditingController();
  final _addressCtrl = TextEditingController();
  final _pincodeCtrl = TextEditingController();
  final _stateCtrl = TextEditingController();
  final _districtCtrl = TextEditingController();
  final _cityCtrl = TextEditingController();
  List<String> _areas = [];
  String? _selectedArea;
  bool _pinLoading = false;

  // ── Step 3 ─────────────────────────────────────────────────────────────────
  final _serviceCtrl = TextEditingController();
  final List<String> _services = [];
  String? _photoB64;                    // profile photo
  final List<String> _portfolioB64 = []; // portfolio images

  // ── Step 4 ─────────────────────────────────────────────────────────────────
  String _planId = 'standard';
  final _customAmountCtrl = TextEditingController();
  // Fallback prices, replaced by live admin-set values once /select/plans
  // resolves. Kept in sync with the backend's DEFAULT_SELECT_PLANS.
  int _premiumPrice = 1200;
  int _standardPrice = 700;

  bool _submitting = false;
  String _payNote = '';

  /// True when editing an existing listing rather than creating a new one.
  bool get _isEditing => widget.existing != null;

  @override
  void initState() {
    super.initState();
    _loadPlanPrices();
    _prefillFromExisting();
  }

  /// Copies the current listing into the form fields when editing. Photos
  /// aren't prefilled as base64 (the server only returns URLs) — leaving them
  /// unset means the backend keeps the existing images untouched unless the
  /// user picks new ones.
  void _prefillFromExisting() {
    final e = widget.existing;
    if (e == null) return;
    _nameCtrl.text = e.name;
    _roleCtrl.text = e.role;
    _aboutCtrl.text = e.about;
    _expCtrl.text = e.experienceYears > 0 ? '${e.experienceYears}' : '';
    _feeCtrl.text =
        e.consultationFee > 0 ? e.consultationFee.toStringAsFixed(0) : '';
    _categoryId = e.category.isNotEmpty ? e.category : null;
    _phoneCtrl.text = e.phone;
    _emailCtrl.text = e.email;
    _addressCtrl.text = e.address;
    _cityCtrl.text = e.city;
    _services.addAll(e.services);
    if (e.area.trim().isNotEmpty) {
      _areas = [e.area];
      _selectedArea = e.area;
    }
    if (e.plan.isNotEmpty) _planId = e.plan;
  }

  @override
  void dispose() {
    _nameCtrl.dispose();
    _roleCtrl.dispose();
    _aboutCtrl.dispose();
    _expCtrl.dispose();
    _feeCtrl.dispose();
    _phoneCtrl.dispose();
    _emailCtrl.dispose();
    _addressCtrl.dispose();
    _pincodeCtrl.dispose();
    _stateCtrl.dispose();
    _districtCtrl.dispose();
    _cityCtrl.dispose();
    _serviceCtrl.dispose();
    _customAmountCtrl.dispose();
    super.dispose();
  }

  Future<void> _loadPlanPrices() async {
    final prices = await SelectService.instance.fetchPlanPrices();
    if (!mounted || prices == null) return;
    setState(() {
      _premiumPrice = prices.premium;
      _standardPrice = prices.standard;
    });
  }

  /// Amount payable for the selected plan.
  double get _amount {
    switch (_planId) {
      case 'premium':
        return _premiumPrice.toDouble();
      case 'standard':
        return _standardPrice.toDouble();
      default:
        return double.tryParse(_customAmountCtrl.text.trim()) ?? 0;
    }
  }

  void _snack(String m) => ScaffoldMessenger.of(context)
      .showSnackBar(SnackBar(content: Text(m)));

  // ── Pincode → state / district / areas (India Post, same as Local Finds) ────
  Future<void> _lookupPincode(String pin) async {
    if (pin.length != 6) return;
    setState(() => _pinLoading = true);
    try {
      final resp = await http
          .get(Uri.parse('https://api.postalpincode.in/pincode/$pin'))
          .timeout(const Duration(seconds: 8));
      if (resp.statusCode == 200) {
        final data = jsonDecode(resp.body);
        if (data is List && data.isNotEmpty && data[0]['Status'] == 'Success') {
          final offices = (data[0]['PostOffice'] as List?) ?? [];
          if (offices.isNotEmpty) {
            final first = offices.first as Map;
            _stateCtrl.text = (first['State'] ?? '').toString();
            _districtCtrl.text = (first['District'] ?? '').toString();
            if (_cityCtrl.text.trim().isEmpty) {
              _cityCtrl.text = (first['District'] ?? '').toString();
            }
            _areas = offices
                .map<String>((o) => ((o as Map)['Name'] ?? '').toString())
                .where((s) => s.isNotEmpty)
                .toSet()
                .toList();
            _selectedArea = _areas.isNotEmpty ? _areas.first : null;
          }
        } else {
          _stateCtrl.text = '';
          _districtCtrl.text = '';
          _areas = [];
          _selectedArea = null;
          _snack('No records found for this pincode');
        }
      }
    } catch (_) {
      _snack('Could not look up pincode. Check your connection.');
    } finally {
      if (mounted) setState(() => _pinLoading = false);
    }
  }

  // ── Photos ──────────────────────────────────────────────────────────────────
  Future<void> _pickProfilePhoto() async {
    try {
      final f = await ImagePicker().pickImage(
          source: ImageSource.gallery, imageQuality: 60);
      if (f == null) return;
      final bytes = await f.readAsBytes();
      if (!mounted) return;
      setState(() => _photoB64 = base64Encode(bytes));
    } catch (_) {
      _snack('Could not add that photo');
    }
  }

  Future<void> _pickPortfolio() async {
    if (_portfolioB64.length >= 12) {
      _snack('You can add up to 12 portfolio photos');
      return;
    }
    try {
      final files = await ImagePicker().pickMultiImage(imageQuality: 60);
      for (final f in files) {
        if (_portfolioB64.length >= 12) break;
        final bytes = await f.readAsBytes();
        _portfolioB64.add(base64Encode(bytes));
      }
      if (mounted) setState(() {});
    } catch (_) {
      _snack('Could not add those photos');
    }
  }

  void _addService() {
    final s = _serviceCtrl.text.trim();
    if (s.isEmpty) return;
    if (_services.length >= 12) {
      _snack('Up to 12 services');
      return;
    }
    setState(() {
      _services.add(s);
      _serviceCtrl.clear();
    });
  }

  // ── Step validation ─────────────────────────────────────────────────────────
  bool _validateStep() {
    if (_step == 0) {
      if (_nameCtrl.text.trim().isEmpty) { _snack('Enter your name'); return false; }
      if (_categoryId == null) { _snack('Select your category'); return false; }
      final fee = double.tryParse(_feeCtrl.text.trim()) ?? -1;
      if (fee < 0) { _snack('Enter a valid consultation fee (0 or more)'); return false; }
    } else if (_step == 1) {
      final phone = _phoneCtrl.text.trim();
      if (phone.length < 10) { _snack('Enter a valid mobile number'); return false; }
      if (_pincodeCtrl.text.trim().length != 6) {
        _snack('Enter a valid 6-digit pincode'); return false;
      }
      if (_cityCtrl.text.trim().isEmpty) { _snack('Enter your city'); return false; }
    } else if (_step == 3) {
      if (_planId == 'custom') {
        final a = double.tryParse(_customAmountCtrl.text.trim());
        if (a == null || a < 0) { _snack('Enter an amount (0 or more)'); return false; }
      }
    }
    return true;
  }

  void _next() {
    if (!_validateStep()) return;
    if (_step < 4) {
      setState(() => _step++);
    } else {
      // Only the final Review step triggers payment + registration.
      _payAndRegister();
    }
  }

  /// Jump straight back to a step from the Review screen's "Edit" links.
  void _goToStep(int s) => setState(() => _step = s);

  void _back() {
    if (_step > 0) {
      setState(() => _step--);
    } else {
      context.canPop() ? context.pop() : context.go('/select');
    }
  }

  // ── Payment + registration ──────────────────────────────────────────────────
  Future<void> _payAndRegister() async {
    if (_submitting) return;
    setState(() {
      _submitting = true;
      _payNote = '';
    });

    final amount = _amount;

    // Editing an existing listing without switching plan — it's already been
    // paid for, so saving changes must not charge again. Switching to a
    // different (paid) plan does go through payment.
    final planUnchanged = _isEditing && widget.existing!.plan == _planId;

    // Free listing (Custom plan at ₹0) — nothing to pay either.
    if (amount <= 0 || planUnchanged) {
      await _register(paymentLinkId: '');
      return;
    }

    setState(() => _payNote = 'Opening secure Razorpay checkout…');
    final link = await PaymentService.instance.createLink(
      amount: amount,
      purpose: 'Claimit Select ${_planId[0].toUpperCase()}${_planId.substring(1)} listing',
    );
    if (!mounted) return;
    if (link == null) {
      setState(() {
        _submitting = false;
        _payNote = '';
      });
      _snack("Couldn't start payment. Please try again shortly.");
      return;
    }

    final opened = await PaymentService.instance.openCheckout(link.url);
    if (!mounted) return;
    if (!opened) {
      setState(() {
        _submitting = false;
        _payNote = '';
      });
      _snack('Could not open the payment page.');
      return;
    }

    setState(() => _payNote =
        'Waiting for payment confirmation… complete the payment in the '
        'browser, then come back to this screen.');

    // Poll until Razorpay reports the link PAID (same cadence and ceiling the
    // Local Finds / Classifieds payment step already uses).
    var attempts = 0;
    while (mounted && attempts < 40) {
      await Future<void>.delayed(const Duration(seconds: 3));
      if (!mounted) return;
      attempts++;
      final status = await PaymentService.instance.checkStatus(link.linkId);
      if (!mounted) return;
      if (status == 'PAID') {
        await _register(paymentLinkId: link.linkId);
        return;
      }
      if (status == 'EXPIRED' || status == 'CANCELLED') {
        setState(() {
          _submitting = false;
          _payNote = '';
        });
        _snack('Payment was not completed. Please try again.');
        return;
      }
    }

    if (!mounted) return;
    setState(() {
      _submitting = false;
      _payNote = '';
    });
    _snack("We couldn't confirm the payment yet. If you've paid, try again in a moment.");
  }

  Future<void> _register({required String paymentLinkId}) async {
    if (mounted) setState(() => _payNote = 'Creating your listing…');

    // Best-effort GPS so the listing can show a real distance in "Nearby".
    final pos = await lfCurrentPosition();

    final saved = await SelectService.instance.registerProfessional({
      'name': _nameCtrl.text.trim(),
      'category': _categoryId,
      'role': _roleCtrl.text.trim(),
      'about': _aboutCtrl.text.trim(),
      'experience_years': int.tryParse(_expCtrl.text.trim()) ?? 0,
      'consultation_fee': double.tryParse(_feeCtrl.text.trim()) ?? 0,
      'services': _services,
      'phone': _phoneCtrl.text.trim(),
      'email': _emailCtrl.text.trim(),
      'address': _addressCtrl.text.trim(),
      'area': _selectedArea ?? '',
      'city': _cityCtrl.text.trim(),
      'district': _districtCtrl.text.trim(),
      'state': _stateCtrl.text.trim(),
      'pincode': _pincodeCtrl.text.trim(),
      'latitude': pos?.latitude,
      'longitude': pos?.longitude,
      'plan': _planId,
      'amount': _amount,
      'payment_link_id': paymentLinkId,
      if (_photoB64 != null) 'photo_base64': _photoB64,
      if (_portfolioB64.isNotEmpty) 'portfolio_base64': _portfolioB64,
    });

    if (!mounted) return;
    setState(() {
      _submitting = false;
      _payNote = '';
    });

    if (saved == null) {
      _snack("Couldn't save your listing. Please try again.");
      return;
    }
    await _showSuccess();
    if (!mounted) return;
    context.go('/select');
  }

