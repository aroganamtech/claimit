// ─── Shops ───────────────────────────────────────────────────
const filterInput = { padding: '8px 10px', border: '1px solid #ddd', borderRadius: 6, fontSize: 12, fontFamily: 'Poppins', outline: 'none', minWidth: 130 }

export function AdminShops() {
  const navigate = useNavigate()
  const [shops, setShops] = useState([]); const [loading, setLoading] = useState(true)
  const [options, setOptions] = useState({ states: [], districts: [], cities: [], categories: [] })
  const [filters, setFilters] = useState({ state: '', district: '', city: '', pincode: '', category: '', shop_name: '', shop_type: '', status: '', claimed: '' })

  const load = (f) => {
    setLoading(true)
    const params = Object.fromEntries(Object.entries(f || filters).filter(([, v]) => v))
    api.admin.listShops(params).then(setShops).finally(() => setLoading(false))
  }
  useEffect(() => { load(filters) }, [filters])
  useEffect(() => { api.admin.shopFilterOptions().then(setOptions).catch(() => {}) }, [])

  const setStatus = async (id, status, e) => { e.stopPropagation(); await api.admin.updateShop(id, { status }); load() }
  const remove = async (id, e) => { e.stopPropagation(); if (confirm('Delete this shop?')) { await api.admin.deleteShop(id); load() } }
  const setF = (k, v) => setFilters(prev => ({ ...prev, [k]: v }))
  const clearFilters = () => setFilters({ state: '', district: '', city: '', pincode: '', category: '', shop_name: '', shop_type: '', status: '', claimed: '' })
  const anyFilterApplied = Object.values(filters).some(Boolean)

  return (
    <PageShell title="Shops" subtitle="Registered shops and their approval state. Click a row for the full landing page.">
      <div style={{ display: 'flex', gap: 10, padding: 16, borderBottom: '1px solid #f0f0f0', flexWrap: 'wrap', alignItems: 'center' }}>
        <select value={filters.state} onChange={e => setF('state', e.target.value)} style={filterInput}>
          <option value="">All states</option>
          {options.states.map(s => <option key={s} value={s}>{s}</option>)}
        </select>
        <select value={filters.district} onChange={e => setF('district', e.target.value)} style={filterInput}>
          <option value="">All districts</option>
          {options.districts.map(d => <option key={d} value={d}>{d}</option>)}
        </select>
        <select value={filters.city} onChange={e => setF('city', e.target.value)} style={filterInput}>
          <option value="">All cities</option>
          {options.cities.map(c => <option key={c} value={c}>{c}</option>)}
        </select>
        <input placeholder="Pincode" value={filters.pincode} onChange={e => setF('pincode', e.target.value)} style={{ ...filterInput, minWidth: 100 }} />
        <select value={filters.category} onChange={e => setF('category', e.target.value)} style={filterInput}>
          <option value="">All categories</option>
          {options.categories.map(c => <option key={c} value={c}>{c}</option>)}
        </select>
        <input placeholder="Shop name" value={filters.shop_name} onChange={e => setF('shop_name', e.target.value)} style={filterInput} />
        <select value={filters.shop_type} onChange={e => setF('shop_type', e.target.value)} style={filterInput}>
          <option value="">Redeem + Reward</option>
          <option value="redeem">Redeem only</option>
          <option value="reward">Reward only</option>
        </select>
        <select value={filters.status} onChange={e => setF('status', e.target.value)} style={filterInput}>
          <option value="">All statuses</option>
          <option value="pending">Pending</option>
          <option value="active">Active</option>
          <option value="suspended">Suspended</option>
        </select>
        <select value={filters.claimed} onChange={e => setF('claimed', e.target.value)} style={filterInput}>
          <option value="">Claimed + Unclaimed</option>
          <option value="yes">Claimed only</option>
          <option value="no">Unclaimed (bulk) only</option>
        </select>
        {anyFilterApplied && <button onClick={clearFilters} style={ghostBtn}>Clear filters</button>}
        <span style={{ fontSize: 12, color: '#888', marginLeft: 'auto' }}>{shops.length} shop{shops.length === 1 ? '' : 's'}</span>
      </div>
      {loading ? <div style={{ padding: 30, textAlign: 'center', color: '#888' }}>Loading…</div>
       : shops.length === 0 ? empty('🏪', 'No shops match these filters')
       : (
        <table style={{ width: '100%', borderCollapse: 'collapse' }}>
          <thead><tr>
            <th style={th}>Shop</th><th style={th}>Address</th><th style={th}>State / District / City</th>
            <th style={th}>Pincode</th><th style={th}>Category</th><th style={th}>Type</th>
            <th style={th}>Discount</th><th style={th}>Favorites</th><th style={th}>Status</th><th style={th}></th>
          </tr></thead>
          <tbody>
            {shops.map(s => (
              <tr key={s.id} onClick={() => navigate(`/admin/shops/${s.id}`)} style={{ cursor: 'pointer' }}>
                <td style={td}><strong>{s.shop_name || s.name}</strong></td>
                <td style={td}>{s.shop_address || s.address}</td>
                <td style={td}>{[s.state, s.district, s.city].filter(Boolean).join(' / ') || '—'}</td>
                <td style={td}>{s.pincode || '—'}</td>
                <td style={td}>{s.category}</td>
                <td style={td}>
                  {s.shop_type
                    ? <span style={{ fontSize: 11, fontWeight: 700, padding: '3px 8px', borderRadius: 20, textTransform: 'capitalize', background: s.shop_type === 'reward' ? '#e8f5e9' : '#e3f2fd', color: s.shop_type === 'reward' ? '#2e7d32' : '#1565c0' }}>{s.shop_type}</span>
                    : <span style={{ fontSize: 11, color: '#999' }}>unclaimed</span>}
                </td>
                <td style={td}>{s.discount_percentage ?? 0}%</td>
                <td style={td}>{s.favorites_count ?? 0}</td>
                <td style={td} onClick={e => e.stopPropagation()}>
                  <select value={s.status || 'pending'} onChange={e => setStatus(s.id, e.target.value, e)}
                    style={{ padding: '4px 8px', borderRadius: 4, border: '1px solid #ccc', fontSize: 12 }}>
                    <option value="pending">pending</option>
                    <option value="active">active</option>
                    <option value="suspended">suspended</option>
                  </select>
                </td>
                <td style={td} onClick={e => e.stopPropagation()}><button style={dangerBtn} onClick={e => remove(s.id, e)}>Delete</button></td>
              </tr>
            ))}
          </tbody>
        </table>
       )}
    </PageShell>
  )
}

